{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://link42.app/patch8/contracts/dataset-manifest.schema.json",
  "title": "Patch8 immutable dataset release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "dataset",
    "release_id",
    "storage",
    "compatibility",
    "rights_policy",
    "previous_good",
    "clocks",
    "release_bounds",
    "table_schemas",
    "routing",
    "artifacts",
    "source_snapshots",
    "field_lineage",
    "derivations",
    "coverage"
  ],
  "properties": {
    "manifest_version": { "const": 1 },
    "dataset": { "const": "patch8" },
    "release_id": { "$ref": "#/$defs/safeId" },
    "storage": { "$ref": "#/$defs/storage" },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "rights_policy": { "$ref": "#/$defs/rightsPolicy" },
    "previous_good": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/previousGood" }
      ]
    },
    "clocks": { "$ref": "#/$defs/clocks" },
    "release_bounds": { "$ref": "#/$defs/releaseBounds" },
    "table_schemas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tableSchema" }
    },
    "routing": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/route" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceSnapshot" }
    },
    "field_lineage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/fieldLineage" }
    },
    "derivations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/derivation" }
    },
    "coverage": { "$ref": "#/$defs/coverage" }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*/$)[A-Za-z0-9][A-Za-z0-9._/=-]*$"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "immutable_data_revision", "base_url"],
      "properties": {
        "provider": { "const": "huggingface" },
        "repository": { "const": "link42-au/patch" },
        "immutable_data_revision": { "$ref": "#/$defs/revision" },
        "base_url": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_reader_manifest_version", "max_reader_manifest_version", "min_schema_version", "max_schema_version", "rights_policy_version"],
      "properties": {
        "min_reader_manifest_version": { "type": "integer", "minimum": 1 },
        "max_reader_manifest_version": { "type": "integer", "minimum": 1 },
        "min_schema_version": { "type": "integer", "minimum": 1 },
        "max_schema_version": { "type": "integer", "minimum": 1 },
        "rights_policy_version": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "rightsPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "schema_version", "path", "sha256", "use_mode"],
      "properties": {
        "id": { "const": "patch8-public-dataset" },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "schema_version": { "const": 1 },
        "path": { "const": "docs/licensing/source-policy.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "use_mode": { "const": "public_dataset_republication" }
      }
    },
    "previousGood": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "manifest_revision", "data_revision", "manifest_url", "manifest_sha256"],
      "properties": {
        "release_id": { "$ref": "#/$defs/safeId" },
        "manifest_revision": { "$ref": "#/$defs/revision" },
        "data_revision": { "$ref": "#/$defs/revision" },
        "manifest_url": { "$ref": "#/$defs/httpsUrl" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "clocks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latest_source_checked_at", "latest_source_modified_at", "dataset_built_at", "manifest_published_at", "stale_at"],
      "properties": {
        "latest_source_checked_at": { "$ref": "#/$defs/dateTime" },
        "latest_source_modified_at": { "$ref": "#/$defs/dateTime" },
        "dataset_built_at": { "$ref": "#/$defs/dateTime" },
        "manifest_published_at": { "$ref": "#/$defs/dateTime" },
        "stale_at": { "$ref": "#/$defs/dateTime" }
      }
    },
    "releaseBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_artifact_bytes", "max_rows_per_artifact", "max_candidate_artifacts_per_query", "max_repository_revisions", "max_retained_bytes", "observed_repository_revisions", "observed_retained_bytes"],
      "properties": {
        "max_artifact_bytes": { "type": "integer", "minimum": 1 },
        "max_rows_per_artifact": { "type": "integer", "minimum": 1 },
        "max_candidate_artifacts_per_query": { "type": "integer", "minimum": 1 },
        "max_repository_revisions": { "type": "integer", "minimum": 2 },
        "max_retained_bytes": { "type": "integer", "minimum": 1 },
        "observed_repository_revisions": { "type": "integer", "minimum": 1 },
        "observed_retained_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "nullable"],
      "properties": {
        "name": { "$ref": "#/$defs/safeId" },
        "type": { "$ref": "#/$defs/nonEmpty" },
        "nullable": { "type": "boolean" }
      }
    },
    "tableSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "schema_sha256", "primary_key", "sort_keys", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "version": { "const": 1 },
        "schema_sha256": { "$ref": "#/$defs/sha256" },
        "primary_key": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/safeId" } },
        "sort_keys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/safeId" } },
        "fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/field" } }
      }
    },
    "routeDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partition_key", "source_field", "transform"],
      "properties": {
        "partition_key": { "$ref": "#/$defs/safeId" },
        "source_field": { "$ref": "#/$defs/safeId" },
        "transform": { "enum": ["identity", "cve_year", "sha256_prefix", "year_utc", "month_utc", "constant"] },
        "parameter": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "maximum_candidate_artifacts", "dimensions"],
      "properties": {
        "schema_id": { "$ref": "#/$defs/safeId" },
        "maximum_candidate_artifacts": { "type": "integer", "minimum": 1 },
        "dimensions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/routeDimension" } }
      }
    },
    "scalar": { "type": ["string", "number", "boolean", "null"] },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "schema_id", "schema_version", "data_revision", "relative_path", "media_type", "byte_size", "sha256", "row_count", "partition_values", "key_min", "key_max", "source_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "kind": { "const": "parquet" },
        "schema_id": { "$ref": "#/$defs/safeId" },
        "schema_version": { "const": 1 },
        "data_revision": { "$ref": "#/$defs/revision" },
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "media_type": { "const": "application/vnd.apache.parquet" },
        "byte_size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "row_count": { "type": "integer", "minimum": 0 },
        "partition_values": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": { "^[A-Za-z0-9][A-Za-z0-9._-]*$": { "$ref": "#/$defs/scalar" } }
        },
        "key_min": { "$ref": "#/$defs/scalar" },
        "key_max": { "$ref": "#/$defs/scalar" },
        "source_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/safeId" } }
      }
    },
    "watermark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "cursor", "contiguous"],
      "properties": {
        "kind": { "enum": ["git_commit", "catalogue_version", "api_window", "archive_version"] },
        "cursor": { "$ref": "#/$defs/nonEmpty" },
        "contiguous": { "const": true },
        "previous_end": { "$ref": "#/$defs/dateTime" },
        "window_start": { "$ref": "#/$defs/dateTime" },
        "window_end": { "$ref": "#/$defs/dateTime" }
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "endpoint_or_repository", "immutable_revision", "record_path", "input_sha256", "input_bytes", "checked_at", "source_modified_at", "source_retrieved_at", "source_observed_at", "last_successful_watermark", "watermark", "notice_ids"],
      "properties": {
        "source_id": { "$ref": "#/$defs/safeId" },
        "endpoint_or_repository": { "$ref": "#/$defs/httpsUrl" },
        "immutable_revision": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/revision" }] },
        "record_path": { "$ref": "#/$defs/relativePath" },
        "input_sha256": { "$ref": "#/$defs/sha256" },
        "input_bytes": { "type": "integer", "minimum": 1 },
        "checked_at": { "$ref": "#/$defs/dateTime" },
        "source_modified_at": { "$ref": "#/$defs/dateTime" },
        "source_retrieved_at": { "$ref": "#/$defs/dateTime" },
        "source_observed_at": { "$ref": "#/$defs/dateTime" },
        "last_successful_watermark": { "$ref": "#/$defs/nonEmpty" },
        "watermark": { "$ref": "#/$defs/watermark" },
        "notice_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/safeId" } }
      }
    },
    "fieldLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "field", "source_id", "source_field", "provenance_required"],
      "properties": {
        "table": { "$ref": "#/$defs/safeId" },
        "field": { "$ref": "#/$defs/safeId" },
        "source_id": { "$ref": "#/$defs/safeId" },
        "source_field": { "$ref": "#/$defs/nonEmpty" },
        "provenance_required": { "const": true }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_table", "output_field", "rule_id", "rule_version", "input_fields", "provenance_required"],
      "properties": {
        "output_table": { "$ref": "#/$defs/safeId" },
        "output_field": { "$ref": "#/$defs/safeId" },
        "rule_id": { "$ref": "#/$defs/safeId" },
        "rule_version": { "type": "integer", "minimum": 1 },
        "input_fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "provenance_required": { "const": true }
      }
    },
    "sourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "state", "checked_at", "stale_at"],
      "properties": {
        "source_id": { "$ref": "#/$defs/safeId" },
        "state": { "enum": ["current", "stale", "unavailable"] },
        "checked_at": { "$ref": "#/$defs/dateTime" },
        "stale_at": { "$ref": "#/$defs/dateTime" }
      }
    },
    "capabilityCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "state", "source_ids", "coverage_numerator", "coverage_denominator", "as_at"],
      "properties": {
        "capability_id": { "$ref": "#/$defs/safeId" },
        "state": { "enum": ["supported", "partial", "unsupported", "unavailable", "stale"] },
        "source_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/safeId" } },
        "coverage_numerator": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
        "coverage_denominator": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
        "as_at": { "$ref": "#/$defs/dateTime" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "capabilities"],
      "properties": {
        "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sourceCoverage" } },
        "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/capabilityCoverage" } }
      }
    }
  }
}
