{
  "schema_version": 1,
  "cases": [
    {
      "name": "accept complete Patch8 v1 release manifest",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [],
      "expected_error_codes": []
    },
    {
      "name": "reject unsupported reader compatibility",
      "reader": { "manifest_version": 2, "schema_version": 1 },
      "mutations": [],
      "expected_error_codes": ["COMPATIBILITY_INVALID"]
    },
    {
      "name": "reject a table whose field order differs from the v1 content contract",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/table_schemas/0/fields/1/name", "value": "unexpected_field" }],
      "expected_error_codes": ["DERIVATION_INVALID", "FIELD_PROVENANCE_INVALID", "TABLE_SCHEMA_FINGERPRINT_INVALID", "TABLE_SCHEMA_INVALID"]
    },
    {
      "name": "reject a table schema fingerprint that does not bind its fields",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/table_schemas/0/schema_sha256", "value": "3333333333333333333333333333333333333333333333333333333333333333" }],
      "expected_error_codes": ["TABLE_SCHEMA_FINGERPRINT_INVALID"]
    },
    {
      "name": "reject widening an exact field type",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/table_schemas/0/fields/1/type", "value": "UTF8" }],
      "expected_error_codes": ["TABLE_SCHEMA_FINGERPRINT_INVALID", "TABLE_SCHEMA_INVALID"]
    },
    {
      "name": "reject widening exact field nullability",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/table_schemas/0/fields/0/nullable", "value": true }],
      "expected_error_codes": ["TABLE_SCHEMA_FINGERPRINT_INVALID", "TABLE_SCHEMA_INVALID"]
    },
    {
      "name": "reject a coordinated type-contract and recomputed-schema change at contract version 1",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "contract_mutations": [{ "operation": "set", "path": "/field_type_overrides/kev_observations.notes", "value": "INT32" }],
      "mutations": [],
      "expected_error_codes": ["VERSION_TRANSITION_REQUIRED"]
    },
    {
      "name": "reject a self-declared primary key",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/table_schemas/0/primary_key", "value": ["cve_year"] }],
      "expected_error_codes": ["TABLE_SCHEMA_FINGERPRINT_INVALID", "TABLE_SCHEMA_INVALID"]
    },
    {
      "name": "reject self-declared sort keys",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/table_schemas/0/sort_keys", "value": ["cve_year"] }],
      "expected_error_codes": ["TABLE_SCHEMA_FINGERPRINT_INVALID", "TABLE_SCHEMA_INVALID"]
    },
    {
      "name": "reject an unknown top-level manifest field",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/unexpected", "value": true }],
      "expected_error_codes": ["UNKNOWN_FIELD"]
    },
    {
      "name": "reject a mutable storage locator",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/storage/base_url", "value": "https://huggingface.co/datasets/link42-au/patch/resolve/main/" }],
      "expected_error_codes": ["MIXED_REVISION"]
    },
    {
      "name": "reject an artifact from a mixed data revision",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/artifacts/0/data_revision", "value": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" }],
      "expected_error_codes": ["MIXED_REVISION"]
    },
    {
      "name": "reject unsafe artifact traversal",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/artifacts/0/relative_path", "value": "../secrets.parquet" }],
      "expected_error_codes": ["PATH_UNSAFE"]
    },
    {
      "name": "reject a malformed artifact checksum",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/artifacts/0/sha256", "value": "bad" }],
      "expected_error_codes": ["CHECKSUM_INVALID"]
    },
    {
      "name": "reject an artifact above the byte ceiling",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/artifacts/0/byte_size", "value": 10485761 }],
      "expected_error_codes": ["ARTIFACT_BOUND_EXCEEDED"]
    },
    {
      "name": "reject an artifact above the row ceiling",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/artifacts/0/row_count", "value": 100001 }],
      "expected_error_codes": ["ARTIFACT_BOUND_EXCEEDED"]
    },
    {
      "name": "reject reversed artifact key bounds",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/artifacts/0/key_min", "value": "record-9" }],
      "expected_error_codes": ["PARTITION_BOUND_INVALID"]
    },
    {
      "name": "reject a missing partition coordinate",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/artifacts/0/partition_values", "value": {} }],
      "expected_error_codes": ["PARTITION_BOUND_INVALID"]
    },
    {
      "name": "reject a raw artifact claim",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/artifacts/0/relative_path", "value": "tables/source_raw/bucket=current/part-00000.parquet" }],
      "expected_error_codes": ["BLOCKED_ARTIFACT"]
    },
    {
      "name": "reject an unregistered artifact source",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/artifacts/0/source_ids", "value": ["patch8_unknown"] }],
      "expected_error_codes": ["SOURCE_INVALID"]
    },
    {
      "name": "reject a blocked EPSS artifact source",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/artifacts/0/source_ids", "value": ["patch8_first_epss"] }],
      "expected_error_codes": ["SOURCE_INVALID"]
    },
    {
      "name": "reject a missing required source snapshot",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "delete", "path": "/source_snapshots/0" }],
      "expected_error_codes": ["FRESHNESS_BOUND_INVALID", "SOURCE_COVERAGE_INVALID", "SOURCE_INVALID"]
    },
    {
      "name": "reject an unpinned cvelistV5 snapshot",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/source_snapshots/0/immutable_revision", "value": null }],
      "expected_error_codes": ["SOURCE_REVISION_UNPINNED"]
    },
    {
      "name": "reject a cvelistV5 cursor that differs from its commit",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/source_snapshots/0/watermark/cursor", "value": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" }],
      "expected_error_codes": ["SOURCE_REVISION_UNPINNED", "WATERMARK_GAP"]
    },
    {
      "name": "reject a gap in the NVD modified window",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/source_snapshots/1/watermark/window_start", "value": "2026-08-28T00:00:01Z" }],
      "expected_error_codes": ["WATERMARK_GAP"]
    },
    {
      "name": "reject GHSA using a non-Git watermark",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/source_snapshots/3/watermark/kind", "value": "catalogue_version" }],
      "expected_error_codes": ["SOURCE_IDENTITY_INVALID", "SOURCE_REVISION_UNPINNED"]
    },
    {
      "name": "reject GHSA using an unreviewed repository locator",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/source_snapshots/3/endpoint_or_repository", "value": "https://example.invalid/evil" }],
      "expected_error_codes": ["SOURCE_IDENTITY_INVALID"]
    },
    {
      "name": "reject Vulnrichment cursor not tied to its immutable commit",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/source_snapshots/4/watermark/cursor", "value": "dddddddddddddddddddddddddddddddddddddddd" }],
      "expected_error_codes": ["SOURCE_REVISION_UNPINNED", "WATERMARK_GAP"]
    },
    {
      "name": "reject missing cvelistV5 notice provenance",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/source_snapshots/0/notice_ids", "value": ["notice.nvd"] }],
      "expected_error_codes": ["SOURCE_NOTICE_INVALID"]
    },
    {
      "name": "reject unsafe non-HTTPS upstream location",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/source_snapshots/0/endpoint_or_repository", "value": "http://example.invalid/cvelist" }],
      "expected_error_codes": ["MANIFEST_STRUCTURE_INVALID", "SOURCE_IDENTITY_INVALID"]
    },
    {
      "name": "reject an unallowed NVD description field",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/field_lineage/0/source_id", "value": "patch8_nvd" }, { "operation": "set", "path": "/field_lineage/0/source_field", "value": "cve.descriptions[].value" }],
      "expected_error_codes": ["FIELD_NOT_ALLOWED", "OUTPUT_LEDGER_INVALID"]
    },
    {
      "name": "reject a missing field provenance decision",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "delete", "path": "/field_lineage/0" }],
      "expected_error_codes": ["FIELD_PROVENANCE_INVALID", "OUTPUT_LEDGER_INVALID"]
    },
    {
      "name": "reject a derivation with unknown inputs",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/derivations/0/input_fields", "value": ["vulnerabilities.unknown"] }],
      "expected_error_codes": ["DERIVATION_INVALID", "OUTPUT_LEDGER_INVALID"]
    },
    {
      "name": "reject deriving a CVE description from its record identifier",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [
        { "operation": "delete_matching", "path": "/field_lineage", "match": {"table": "descriptions", "field": "description"} },
        { "operation": "append", "path": "/derivations", "value": {"output_table": "descriptions", "output_field": "description", "rule_id": "derive_descriptions_description_v1", "rule_version": 1, "transformation_id": "derived_projection_v1", "input_fields": ["descriptions.cve_id"], "source_ids": ["patch8_cvelist_v5"], "notice_ids": ["notice.cve_program"], "pointer_semantics": "derived_value", "provenance_required": true} }
      ],
      "expected_error_codes": ["OUTPUT_LEDGER_INVALID"]
    },
    {
      "name": "reject deriving a CVSS score from its CVE identifier",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [
        { "operation": "delete_matching", "path": "/field_lineage", "match": {"table": "cvss_observations", "field": "base_score"} },
        { "operation": "append", "path": "/derivations", "value": {"output_table": "cvss_observations", "output_field": "base_score", "rule_id": "derive_cvss_observations_base_score_v1", "rule_version": 1, "transformation_id": "derived_projection_v1", "input_fields": ["cvss_observations.cve_id"], "source_ids": ["patch8_nvd"], "notice_ids": ["notice.nvd"], "pointer_semantics": "derived_value", "provenance_required": true} }
      ],
      "expected_error_codes": ["OUTPUT_LEDGER_INVALID"]
    },
    {
      "name": "reject deriving schema version from a vulnerability record",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set_matching", "path": "/derivations", "match": {"output_table": "vulnerabilities", "output_field": "schema_version"}, "field": "input_fields", "value": ["vulnerabilities.cve_id"] }],
      "expected_error_codes": ["OUTPUT_LEDGER_INVALID"]
    },
    {
      "name": "reject weakening NVD source-path identity inputs",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set_matching", "path": "/derivations", "match": {"output_table": "affected_software", "output_field": "configuration_id"}, "field": "input_fields", "value": ["affected_software.cve_id"] }],
      "expected_error_codes": ["OUTPUT_LEDGER_INVALID"]
    },
    {
      "name": "reject a false zero for unavailable EPSS",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/coverage/capabilities/7/coverage_numerator", "value": 0 }, { "operation": "set", "path": "/coverage/capabilities/7/coverage_denominator", "value": 0 }],
      "expected_error_codes": ["CAPABILITY_FALSE_ZERO"]
    },
    {
      "name": "reject a false supported Patch Tuesday state",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/coverage/capabilities/8/state", "value": "supported" }],
      "expected_error_codes": ["CAPABILITY_COVERAGE_INVALID", "CAPABILITY_STATE_INVALID"]
    },
    {
      "name": "reject a capability claim from blocked EPSS",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/coverage/capabilities/0/source_ids", "value": ["patch8_first_epss"] }],
      "expected_error_codes": ["CAPABILITY_STATE_INVALID", "SOURCE_INVALID"]
    },
    {
      "name": "reject duplicate source coverage identities",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "copy", "from": "/coverage/sources/0", "path": "/coverage/sources" }],
      "expected_error_codes": ["MANIFEST_STRUCTURE_INVALID", "SOURCE_COVERAGE_DUPLICATE"]
    },
    {
      "name": "reject duplicate capability coverage identities",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "copy", "from": "/coverage/capabilities/0", "path": "/coverage/capabilities" }],
      "expected_error_codes": ["CAPABILITY_COVERAGE_DUPLICATE", "MANIFEST_STRUCTURE_INVALID"]
    },
    {
      "name": "reject supported capabilities when cvelistV5 is unavailable",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/coverage/sources/0/state", "value": "unavailable" }],
      "expected_error_codes": ["CAPABILITY_STATE_INVALID"]
    },
    {
      "name": "accept honest capability degradation when cvelistV5 is unavailable",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [
        { "operation": "set", "path": "/coverage/sources/0/state", "value": "unavailable" },
        { "operation": "set", "path": "/coverage/capabilities/0/state", "value": "unavailable" },
        { "operation": "set", "path": "/coverage/capabilities/0/coverage_numerator", "value": null },
        { "operation": "set", "path": "/coverage/capabilities/0/coverage_denominator", "value": null },
        { "operation": "set", "path": "/coverage/capabilities/1/state", "value": "unavailable" },
        { "operation": "set", "path": "/coverage/capabilities/1/coverage_numerator", "value": null },
        { "operation": "set", "path": "/coverage/capabilities/1/coverage_denominator", "value": null }
      ],
      "expected_error_codes": []
    },
    {
      "name": "reject capability numerator above denominator",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/coverage/capabilities/0/coverage_numerator", "value": 2 }],
      "expected_error_codes": ["CAPABILITY_COVERAGE_INVALID"]
    },
    {
      "name": "reject partial capability claiming complete coverage",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/coverage/capabilities/4/coverage_denominator", "value": 1 }],
      "expected_error_codes": ["CAPABILITY_COVERAGE_INVALID"]
    },
    {
      "name": "reject capability as-at time not bound to dataset build",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/coverage/capabilities/0/as_at", "value": "2026-08-29T01:21:00Z" }],
      "expected_error_codes": ["CAPABILITY_STATE_INVALID"]
    },
    {
      "name": "reject source coverage check time not bound to its snapshot",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/coverage/sources/0/checked_at", "value": "2026-08-29T01:01:00Z" }],
      "expected_error_codes": ["FRESHNESS_BOUND_INVALID"]
    },
    {
      "name": "reject a mismatched rights-policy digest",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/rights_policy/sha256", "value": "2222222222222222222222222222222222222222222222222222222222222222" }],
      "expected_error_codes": ["RIGHTS_POLICY_INVALID"]
    },
    {
      "name": "reject a previous-good pointer to the current data",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/previous_good/data_revision", "value": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }],
      "expected_error_codes": ["PREVIOUS_GOOD_INVALID"]
    },
    {
      "name": "reject repository revision growth above the ceiling",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/release_bounds/observed_repository_revisions", "value": 65 }],
      "expected_error_codes": ["REPOSITORY_GROWTH_EXCEEDED"]
    },
    {
      "name": "reject retained bytes above the ceiling",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/release_bounds/observed_retained_bytes", "value": 10737418241 }],
      "expected_error_codes": ["REPOSITORY_GROWTH_EXCEEDED"]
    },
    {
      "name": "reject a manifest published before its build",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/clocks/manifest_published_at", "value": "2026-08-29T01:19:59Z" }],
      "expected_error_codes": ["CLOCK_INVALID"]
    },
    {
      "name": "reject a manifest latest-source clock not bound to its snapshots",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/clocks/latest_source_checked_at", "value": "2026-08-29T01:05:00Z" }],
      "expected_error_codes": ["CLOCK_INVALID"]
    },
    {
      "name": "reject a manifest stale clock not bound to its earliest source boundary",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/clocks/stale_at", "value": "2026-08-30T07:00:01Z" }],
      "expected_error_codes": ["CLOCK_INVALID"]
    },
    {
      "name": "reject a supported capability whose required source claims stale",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/coverage/sources/0/state", "value": "stale" }],
      "expected_error_codes": ["SOURCE_STATE_INVALID", "CAPABILITY_STATE_INVALID"]
    },
    {
      "name": "reject a source stale time outside its v1 freshness threshold",
      "reader": { "manifest_version": 1, "schema_version": 1 },
      "mutations": [{ "operation": "set", "path": "/coverage/sources/0/stale_at", "value": "2026-08-30T08:00:00Z" }],
      "expected_error_codes": ["FRESHNESS_BOUND_INVALID"]
    }
  ]
}
