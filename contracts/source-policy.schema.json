{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://link42.app/patch8/contracts/source-policy.schema.json",
  "title": "Patch8 public dataset source policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "product",
    "use_mode",
    "generated_dataset_default_license",
    "unknown_source_policy",
    "unknown_field_policy",
    "unknown_use_mode_policy",
    "unknown_authorship_policy",
    "terms_review_interval_days",
    "sources"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "policy_id": { "const": "patch8-public-dataset" },
    "policy_version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "product": { "const": "patch8" },
    "use_mode": { "const": "public_dataset_republication" },
    "generated_dataset_default_license": { "type": "null" },
    "unknown_source_policy": { "const": "block" },
    "unknown_field_policy": { "const": "block" },
    "unknown_use_mode_policy": { "const": "block" },
    "unknown_authorship_policy": { "const": "block" },
    "terms_review_interval_days": { "type": "integer", "minimum": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "safeId": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "decision",
        "enabled",
        "allowed_use_modes",
        "publication_mode",
        "terms_reviewed_at",
        "official_terms_urls",
        "immutable_revision_required",
        "record_path_required",
        "record_sha256_required",
        "field_lineage_required",
        "required_notice_ids",
        "allowed_fields",
        "blocked_artifacts",
        "attribution",
        "raw_publication",
        "raw_private_retention_days",
        "refresh_method",
        "blocker"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "display_name": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["allow", "block", "exclude"] },
        "enabled": { "type": "boolean" },
        "allowed_use_modes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "const": "public_dataset_republication" }
        },
        "publication_mode": { "type": "string", "minLength": 1 },
        "terms_reviewed_at": { "type": "string", "format": "date" },
        "official_terms_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/httpsUrl" }
        },
        "repository": { "$ref": "#/$defs/httpsUrl" },
        "immutable_revision_required": { "type": "boolean" },
        "record_path_required": { "type": "boolean" },
        "record_sha256_required": { "type": "boolean" },
        "field_lineage_required": { "type": "boolean" },
        "required_notice_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeId" }
        },
        "allowed_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "blocked_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "attribution": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "raw_publication": { "const": false },
        "raw_private_retention_days": { "type": "integer", "minimum": 0, "maximum": 90 },
        "refresh_method": { "type": "string", "minLength": 1 },
        "blocker": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        }
      }
    }
  }
}
