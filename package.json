{
  "name": "patch8",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "22.23.1",
    "pnpm": "10.15.1"
  },
  "pnpm": {
    "overrides": {
      "cookie": "0.7.2"
    }
  },
  "scripts": {
    "build": "pnpm --filter @patch8/web build",
    "check": "biome check .",
    "format": "biome check --write .",
    "hf:p2:finalize": "pnpm --filter @patch8/web hf:p2:finalize",
    "hf:p2:prepare": "pnpm --filter @patch8/web hf:p2:prepare",
    "test": "pnpm test:ingestion && pnpm --filter @patch8/web fixtures:check && node --test scripts/*.test.mjs && pnpm --filter @patch8/web test",
    "test:ingestion": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s ingestion/tests -v",
    "test:e2e": "pnpm --filter @patch8/web proof:build && playwright test",
    "test:e2e:hf": "pnpm --filter @patch8/web proof:hf:build && playwright test e2e/p2-hf.spec.ts",
    "typecheck": "pnpm --filter @patch8/web typecheck",
    "validate:contract": "node scripts/validate-dataset-contract.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:static": "node scripts/verify-static.mjs",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm validate:contract && pnpm build && pnpm verify:architecture && pnpm verify:static"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.4.6",
    "@playwright/test": "1.62.1",
    "@types/node": "22.15.3",
    "typescript": "5.9.3"
  }
}
