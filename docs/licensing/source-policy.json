    {
      "id": "patch8_cvelist_v5",
      "display_name": "CVE Program cvelistV5",
      "decision": "allow",
      "enabled": true,
      "allowed_use_modes": ["public_dataset_republication"],
      "publication_mode": "normalized_fields",
      "terms_reviewed_at": "2026-08-29",
      "official_terms_urls": [
        "https://www.cve.org/Legal/TermsOfUse",
        "https://www.cve.org/Downloads",
        "https://github.com/CVEProject/cvelistV5"
      ],
      "repository": "https://github.com/CVEProject/cvelistV5",
      "source_locator": "https://github.com/CVEProject/cvelistV5",
      "immutable_revision_required": true,
      "record_path_required": true,
      "record_sha256_required": true,
      "field_lineage_required": true,
      "required_notice_ids": ["notice.cve_program"],
      "allowed_fields": [
        "dataVersion",
        "cveMetadata.cveId",
        "cveMetadata.state",
        "cveMetadata.datePublished",
        "cveMetadata.dateUpdated",
        "cveMetadata.assignerOrgId",
        "cveMetadata.assignerShortName",
        "containers.cna.providerMetadata.orgId",
        "containers.cna.providerMetadata.shortName",
        "containers.cna.providerMetadata.dateUpdated",
        "containers.cna.descriptions[].lang",
        "containers.cna.descriptions[].value"
      ],
      "blocked_artifacts": [
        "containers.adp.*",
        "supporting_media_body",
        "credit.*",
        "extension.*",
        "linked_document_body",
        "raw_record",
        "raw_repository_archive"
      ],
      "attribution": "CVE Program CVE Records; reproduced and transformed under the CVE Terms of Use. Preserve the CVE and MITRE notice and identify Link42 modifications.",
      "raw_publication": false,
      "raw_private_retention_days": 7,
      "refresh_method": "Daily conditional fetch of the official CVEProject/cvelistV5 repository at an immutable 40-hex Git commit",
      "blocker": null
    },
    {
      "id": "patch8_nvd",
      "display_name": "NVD API 2.0 and change history",
      "decision": "allow",
      "enabled": true,
      "allowed_use_modes": ["public_dataset_republication"],
      "publication_mode": "normalized_fields",
      "terms_reviewed_at": "2026-08-28",
      "official_terms_urls": [
        "https://nvd.nist.gov/developers/request-an-api-key",
        "https://www.nist.gov/open/license",
        "https://www.cve.org/Legal/TermsOfUse"
      ],
      "source_locator": "https://services.nvd.nist.gov/rest/json/cves/2.0",
      "immutable_revision_required": false,
      "record_path_required": true,
      "record_sha256_required": true,
      "field_lineage_required": true,
      "required_notice_ids": ["notice.nvd"],
      "allowed_fields": [
        "cve.id",
        "cve.published",
        "cve.lastModified",
        "cve.sourceIdentifier",
        "cve.vulnStatus",
        "nvd.cvss.source",
        "nvd.cvss.type",
        "nvd.cvss.cvssData.version",
        "nvd.cvss.cvssData.vectorString",
        "nvd.cvss.cvssData.baseScore",
        "nvd.cvss.cvssData.baseSeverity",
        "cve.metrics.cvssMetricV2[].baseSeverity",
        "nvd.weakness.cwe_id",
        "cve.configurations[].operator",
        "cve.configurations[].negate",
        "cve.configurations[].nodes[].operator",
        "cve.configurations[].nodes[].negate",
        "cve.configurations[].nodes[].cpeMatch[].vulnerable",
        "cve.configurations[].nodes[].cpeMatch[].criteria",
        "cve.configurations[].nodes[].cpeMatch[].matchCriteriaId",
        "cve.configurations[].nodes[].cpeMatch[].versionStartIncluding",
        "cve.configurations[].nodes[].cpeMatch[].versionStartExcluding",
        "cve.configurations[].nodes[].cpeMatch[].versionEndIncluding",
        "cve.configurations[].nodes[].cpeMatch[].versionEndExcluding",
        "nvd.reference.url",
        "nvd.reference.tags",
        "nvd.history.change_time",
        "nvd.history.change_type",
        "nvd.history.allowed_value_change",
        "nvd.history.denied_value_sha256"
      ],
      "blocked_artifacts": [
        "cve.descriptions.*",
        "vendor_comment.*",
        "unverified_third_party_text",
        "linked_document_body",
        "raw_response"
      ],
      "attribution": "This product uses data from the NVD API but is not endorsed or certified by the NVD. Link42 modifies and normalizes NVD-authored structured fields.",
      "raw_publication": false,
      "raw_private_retention_days": 90,
      "refresh_method": "NVD API modified-date windows with overlap, a contiguous persisted watermark, rate headers, and no more than one automated delta cycle every two hours",
      "blocker": null
    },
